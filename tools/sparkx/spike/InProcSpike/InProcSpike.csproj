<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>InProcSpike</AssemblyName>
    <RootNamespace>InProcSpike</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\src\Core\HeapSnapshot.cs" Link="Core\HeapSnapshot.cs" />
    <Compile Include="..\..\..\..\src\Core\HeapDumpEventPipe.cs" Link="Core\HeapDumpEventPipe.cs" />
    <Compile Include="..\..\..\..\src\Core\MemoryReport.cs" Link="Core\MemoryReport.cs" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.28" />
  </ItemGroup>
</Project>
