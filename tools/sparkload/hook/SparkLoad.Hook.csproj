<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OptimumDir Condition="'$(OptimumDir)' == ''">$(LOCALAPPDATA)\Programs\Optimum</OptimumDir>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SparkLoad.Hook</AssemblyName>
    <RootNamespace>SparkLoad.Hook</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\..\..\sparkload-build\out\hook\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- compile-time only: the game process resolves 0Harmony at run time (Optimum's resolver). Never copied. -->
    <Reference Include="0Harmony">
      <HintPath>$(OptimumDir)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
